# Porta do servidor (Railway injeta PORT automaticamente)
PORT=3001
# Deixe vazio para usar MongoDB em memoria (desenvolvimento/Codespaces).
# Para MongoDB Atlas: mongodb+srv://usuario:senha@cluster.mongodb.net/kinoaqua
MONGO_URI=
JWT_SECRET=troque-este-segredo
# Origens permitidas separadas por virgula. Use * para liberar tudo em desenvolvimento.
# Exemplo producao: https://kinoaqua.vercel.app
CORS_ORIGINS=*
# E-mails extras (separados por virgula) que serao tratados como administradores
ADMIN_EMAILS=
