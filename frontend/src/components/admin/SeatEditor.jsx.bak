import { useState } from 'react';
import { Armchair, Crown, Wrench } from 'lucide-react';
import { api } from '../../lib/api';
import { friendlyError } from '../../lib/errors';
import { ErrorBox } from './ui';

const MODES = [
  { id: 'broken', label: 'Manutenção', icon: Wrench },
  { id: 'vip', label: 'VIP', icon: Crown },
  { id: 'available', label: 'Normal', icon: Armchair },
];

const STYLES = {
  available: 'border-aqua-400/70 text-aqua-400 hover:bg-aqua-400/15',
  vip: 'border-[#7C8CFF]/80 bg-[#7C8CFF]/10 text-[#A5B0FF] hover:bg-[#7C8CFF]/20',
  broken: 'border-amber-400/60 bg-amber-400/10 text-amber-300 hover:bg-amber-400/20',
};

export default function SeatEditor({ movie, onUpdate }) {
  const [mode, setMode] = useState('broken');
  const [reason, setReason] = useState('');
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState('');
  const room = movie.room;
  const broken = new Map(room.brokenSeats.map((b) => [b.code, b.reason]));
  const vip = new Set(room.vipSeats);
  const gapAfter = room.cols >= 8 ? Math.floor(room.cols / 2) : 0;

  async function click(code) {
    if (busy) return;
    const current = broken.has(code) ? 'broken' : vip.has(code) ? 'vip' : 'available';
    const status = current === mode ? 'available' : mode;
    setBusy(true);
    setError('');
    try {
      const updated = await api.patch(`/movies/${movie.id}/seats`, {
        seat: code,
        status,
        reason: status === 'broken' ? reason : '',
      });
      onUpdate(updated);
    } catch (err) {
      setError(friendlyError(err));
    } finally {
      setBusy(false);
    }
  }

  return (
    <div className="p-4 pt-12 sm:p-6 sm:pt-12">
      <h2 className="text-2xl font-semibold">Editor de poltronas</h2>
      <p className="mt-1 text-sm text-mist">
        {room.name} - {room.technology} - {room.rows.length} fileiras x {room.cols} colunas. Escolha o modo e clique nas poltronas. Clicar de novo no mesmo modo devolve a poltrona ao normal.
      </p>

      <div className="mt-5 flex flex-wrap gap-2">
        {MODES.map((m) => (
          <button
            key={m.id}
            type="button"
            onClick={() => setMode(m.id)}
            className={`flex items-center gap-2 rounded-lg border px-3 py-2 text-sm transition ${
              mode === m.id ? 'border-aqua-neon bg-aqua-neon/15 text-aqua-neon' : 'border-ink-700 text-mist hover:text-ice'
            }`}
          >
            <m.icon className="h-4 w-4" />
            {m.label}
          </button>
        ))}
      </div>

      {mode === 'broken' && (
        <label className="mt-4 block">
          <span className="label">Motivo da manutenção (opcional)</span>
          <input
            type="text"
            value={reason}
            onChange={(e) => setReason(e.target.value)}
            placeholder="Ex: Encosto em manutenção"
            className="input-field !pl-4"
            maxLength={120}
          />
        </label>
      )}

      <div className="mt-6">
        <ErrorBox message={error} />
      </div>

      <div className="mt-4 overflow-x-auto pb-2">
        <p className="mb-3 text-center text-[11px] uppercase tracking-[0.35em] text-mist/70">Tela</p>
        <div className="mx-auto flex w-max flex-col gap-2">
          {room.rows.map((row) => (
            <div key={row} className="flex items-center gap-2">
              <span className="w-5 text-center text-xs font-medium text-mist">{row}</span>
              <div className="flex gap-1.5">
                {Array.from({ length: room.cols }, (_, i) => {
                  const code = `${row}${i + 1}`;
                  const kind = broken.has(code) ? 'broken' : vip.has(code) ? 'vip' : 'available';
                  const Icon = kind === 'broken' ? Wrench : kind === 'vip' ? Crown : Armchair;
                  return (
                    <button
                      key={code}
                      type="button"
                      onClick={() => click(code)}
                      disabled={busy}
                      title={broken.has(code) ? `${code}: ${broken.get(code) || 'Em manutenção'}` : code}
                      aria-label={`Poltrona ${code}, ${kind === 'broken' ? 'em manutenção' : kind === 'vip' ? 'VIP' : 'normal'}`}
                      className={`flex h-9 w-9 items-center justify-center rounded-lg border bg-transparent transition duration-150 disabled:opacity-60 ${STYLES[kind]} ${
                        gapAfter && i + 1 === gapAfter ? 'mr-4' : ''
                      }`}
                    >
                      <Icon className="h-4 w-4" />
                    </button>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div className="mt-6 grid gap-4 sm:grid-cols-2">
        <div className="glass-soft p-4">
          <p className="label">Em manutenção ({room.brokenSeats.length})</p>
          {room.brokenSeats.length === 0 ? (
            <p className="text-sm text-mist">Nenhuma.</p>
          ) : (
            <ul className="space-y-1 text-sm">
              {room.brokenSeats.map((b) => (
                <li key={b.code}>
                  <span className="font-medium text-amber-300">{b.code}</span> <span className="text-mist">{b.reason || 'Sem motivo informado'}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
        <div className="glass-soft p-4">
          <p className="label">VIP ({room.vipSeats.length})</p>
          <p className="text-sm text-mist">{room.vipSeats.length ? room.vipSeats.join(', ') : 'Nenhuma.'}</p>
        </div>
      </div>
    </div>
  );
}
